# Copy this file to `.env` (which is gitignored) and fill in real values.
# The agents read these at startup; nothing here is ever committed.

# Required: your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-REPLACE-ME

# The model slug both agents share. Set the exact slug your OpenRouter
# account lists for the model you want.
OPENROUTER_MODEL=qwen/qwen3.8-27b

# Only needed if you use a different OpenAI-compatible endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Serving (optional; only `python -m averio.demo` reads these) ----------
# Which face of the project this process serves: `demo` (the jury page:
# recorded results + live ask-both-agents) or `enduser` (the chat
# assistant). One checkout, one flag, two deployments. Default: demo.
# AVERIO_VARIANT=demo

# Bind address and port. Defaults stay on the laptop (127.0.0.1:8000);
# hosting platforms inject PORT themselves.
# HOST=127.0.0.1
# PORT=8000

# When set, the endpoints that call the model require this code (the page
# asks once and sends it as the X-Averio-Access header). A soft spend gate
# for a public URL, not authentication. Unset = open, fine for localhost;
# set it before binding to any host others can reach.
# AVERIO_ACCESS_CODE=

# Root holding eval/, data/ and bundle/ when the package is installed
# non-editable (a container image). Read at import time, so it must be a
# real process environment variable - a line here is too late.
# AVERIO_REPO=
